PORT=8080
DATA_DIR=/app/data
CHECK_INTERVAL_MS=60000
JARVIS_OPERATOR_TOKEN=replace-with-a-long-random-token

# Add only verified, read-only health endpoints.  Without this configuration,
# every dependency remains UNKNOWN by design.
# JARVIS_DEPENDENCIES_JSON=[{"id":"vps","name":"VPS runtime","kind":"runtime","healthUrl":"https://example.com/health"}]

# A notification endpoint may acknowledge a message, but it is not considered
# delivered until a provider receipt is recorded through /api/notifications/receipt.
# NOTIFICATION_WEBHOOK_URL=https://provider.example/webhook

# Recovery execution remains disabled by default.  Keep it disabled unless a
# production operator has approved one explicitly whitelisted command.
ALLOW_RECOVERY_ACTIONS=false
# SERVICE_RESTART_COMMAND=systemctl restart jarvis
