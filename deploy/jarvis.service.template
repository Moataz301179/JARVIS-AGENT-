[Unit]
Description=Jarvis Operations Control Plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/jarvis/jarvis.env
ExecStart=__NODE_BIN__ __APP_DIR__/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jarvis

[Install]
WantedBy=multi-user.target
